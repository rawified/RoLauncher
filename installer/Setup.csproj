<Project Sdk="Microsoft.NET.Sdk">

  <!-- RoLauncherSetup.exe: built by ..\build-installer.ps1, which first publishes the app into ..\dist\payload.zip. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RoLauncherSetup</AssemblyName>
    <RootNamespace>RoLauncherSetup</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>RoLauncher Setup</Product>
    <Company>RoLauncher</Company>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\dist\payload.zip" LogicalName="payload.zip" />
    <EmbeddedResource Include="..\assets\logo-256.png" LogicalName="logo.png" />
  </ItemGroup>

</Project>
